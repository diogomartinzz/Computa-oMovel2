<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_v"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.35" />

        <ImageView
            android:id="@+id/imgWeather"
            android:layout_width="0dp"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline_v"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/clear_day" />

        <!-- INPUTS -->
        <TextView
            android:id="@+id/lblLatitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lat_label"
            app:layout_constraintStart_toStartOf="@+id/guideline_v"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/editLat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:inputType="numberDecimal|numberSigned"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblLatitude"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lblLatitude" />

        <TextView
            android:id="@+id/lblLongitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/long_label"
            app:layout_constraintStart_toStartOf="@+id/lblLatitude"
            app:layout_constraintTop_toBottomOf="@+id/editLat" />

        <EditText
            android:id="@+id/editLong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblLongitude"
            app:layout_constraintEnd_toEndOf="@+id/editLat"
            app:layout_constraintStart_toStartOf="@+id/editLat" />

        <TextView
            android:id="@+id/lblPressure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pressure_label"
            app:layout_constraintStart_toStartOf="@+id/lblLongitude"
            app:layout_constraintTop_toBottomOf="@+id/editLong" />

        <TextView
            android:id="@+id/PressureValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblPressure"
            app:layout_constraintEnd_toEndOf="@+id/editLong" />

        <TextView
            android:id="@+id/lblWindDir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wind_dir_label"
            app:layout_constraintStart_toStartOf="@+id/lblPressure"
            app:layout_constraintTop_toBottomOf="@+id/lblPressure" />

        <TextView
            android:id="@+id/WindDirections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblWindDir"
            app:layout_constraintEnd_toEndOf="@+id/PressureValue" />

        <TextView
            android:id="@+id/lblWindSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/wind_speed"
            app:layout_constraintStart_toStartOf="@+id/lblWindDir"
            app:layout_constraintTop_toBottomOf="@+id/lblWindDir" />

        <TextView
            android:id="@+id/WindSpeeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblWindSpeed"
            app:layout_constraintEnd_toEndOf="@+id/WindDirections" />

        <TextView
            android:id="@+id/lblTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/temp_label"
            app:layout_constraintStart_toStartOf="@+id/lblWindSpeed"
            app:layout_constraintTop_toBottomOf="@+id/lblWindSpeed" />

        <TextView
            android:id="@+id/txtTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblTemp"
            app:layout_constraintEnd_toEndOf="@+id/WindSpeeds" />

        <TextView
            android:id="@+id/lblTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/time_label"
            app:layout_constraintStart_toStartOf="@+id/lblTemp"
            app:layout_constraintTop_toBottomOf="@+id/lblTemp" />

        <TextView
            android:id="@+id/TimeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            app:layout_constraintBaseline_toBaselineOf="@+id/lblTime"
            app:layout_constraintEnd_toEndOf="@+id/txtTemperature" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_update"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_v"
            app:layout_constraintTop_toBottomOf="@+id/lblTime" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>